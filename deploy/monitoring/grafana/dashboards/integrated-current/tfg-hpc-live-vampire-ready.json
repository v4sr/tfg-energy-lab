                      "spec": {
                        "editorMode": "code",
                        "expr": "clamp_min(avg_over_time(tfg_live_power_watts{campaign=\"$campaign\",benchmark=~\"$benchmark\",language=~\"$language\",threads=~\"$threads\",node=~\"$node\"}[2s]), 1)",
