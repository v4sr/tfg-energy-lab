    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "name": "DS_PROMETHEUS",
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "current": {
            "text": "Prometheus",
            "value": "Prometheus"
          },
          "options": [],
          "multi": false,
          "includeAll": false,
          "label": "Prometheus",
          "hide": "dontHide",
          "skipUrlSync": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "campaign",
          "current": {
            "text": "hpc_cpu_mem_v1",
            "value": "hpc_cpu_mem_v1"
          },
          "label": "campaign",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${DS_PROMETHEUS}"
            },
            "spec": {
              "query": "label_values(tfg_run_status, campaign)",
              "refId": "Prometheus-campaign"
            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(tfg_run_status, campaign)",
          "options": [],
          "multi": false,
          "includeAll": false,
          "allowCustomValue": true
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "benchmark",
