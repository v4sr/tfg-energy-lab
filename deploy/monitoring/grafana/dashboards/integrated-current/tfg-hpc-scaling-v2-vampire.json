            }
          },
          "regex": "",
          "sort": "alphabeticalAsc",
          "definition": "label_values(tfg_run_status{campaign=\"$campaign\"}, benchmark)",
          "options": [],
          "multi": true,
          "includeAll": true,
          "allValue": ".*",
          "allowCustomValue": true
