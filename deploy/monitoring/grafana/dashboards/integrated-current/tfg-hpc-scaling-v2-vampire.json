            "value": "$__all"
          },
          "label": "benchmark",
          "hide": "dontHide",
          "refresh": "onTimeRangeChanged",
          "skipUrlSync": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "${DS_PROMETHEUS}"
            },
            "spec": {
