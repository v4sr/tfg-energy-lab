                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (cores, benchmark, language, node, vampire_device) (tfg_run_ops_total{campaign=\"$campaign\",benchmark=~\"$benchmark\",language=~\"$language\",threads=~\"$threads\",node=~\"$node\",profile=~\"$profile\",cores=~\"$cores\",run_id=~\"$run_id\"} / on(run_id) group_right(vampire_device) tfg_external_energy_joules{campaign=\"$campaign\",benchmark=~\"$benchmark\",language=~\"$language\",threads=~\"$threads\",node=~\"$node\",profile=~\"$profile\",cores=~\"$cores\",run_id=~\"$run_id\",vampire_device=~\"$vampire_device\"})",
