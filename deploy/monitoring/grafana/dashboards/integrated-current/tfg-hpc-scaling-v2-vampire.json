                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (cores, benchmark, language, node) (tfg_run_avg_power_watts{campaign=\"$campaign\",benchmark=~\"$benchmark\",language=~\"$language\",node=~\"$node\",profile=~\"$profile\",cores=~\"$cores\",run_id=~\"$run_id\"})",
