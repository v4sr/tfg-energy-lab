                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (cores, benchmark, language, node, vampire_device) (tfg_external_average_power_watts{campaign=\"$campaign\",benchmark=~\"$benchmark\",language=~\"$language\",threads=~\"$threads\",node=~\"$node\",profile=~\"$profile\",cores=~\"$cores\",run_id=~\"$run_id\",vampire_device=~\"$vampire_device\"})",
