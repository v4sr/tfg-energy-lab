                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (benchmark, language, cores, node, vampire_device) (tfg_run_ops_total{campaign=\"$campaign\",benchmark=~\"$benchmark\",language=~\"$language\",threads=~\"$threads\",node=~\"$node\",profile=~\"$profile\",cores=~\"$cores\",run_id=~\"$run_id\"} / on(run_id) group_right(vampire_device) tfg_external_energy_joules{campaign=\"$campaign\",benchmark=~\"$benchmark\",language=~\"$language\",threads=~\"$threads\",node=~\"$node\",profile=~\"$profile\",cores=~\"$cores\",run_id=~\"$run_id\",vampire_device=~\"$vampire_device\"})",
                        "format": "time_series",
                        "range": true,
                        "legendFormat": "External Ops/J"
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "reduce",
                  "spec": {
                    "options": {
                      "includeTimeField": false,
                      "labelsToFields": true,
                      "mode": "seriesToRows",
                      "reducers": [
                        "last"
                      ]
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Field": true
                      },
                      "renameByName": {
                        "Last": "Ops/J",
                        "benchmark": "Benchmark",
                        "language": "Language",
                        "node": "Node",
                        "threads": "Cores"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
