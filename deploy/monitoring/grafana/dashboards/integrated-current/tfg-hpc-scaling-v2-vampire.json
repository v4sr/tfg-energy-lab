                      "spec": {
                        "editorMode": "code",
                        "expr": "max by (benchmark, language, threads, node) (tfg_run_ops_per_joule{campaign=\"$campaign\",benchmark=~\"$benchmark\",language=~\"$language\",node=~\"$node\",profile=~\"$profile\",cores=~\"$cores\",run_id=~\"$run_id\"})",
